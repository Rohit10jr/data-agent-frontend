# Default — auto-detect text vs binary, normalize line endings to LF in repo
* text=auto eol=lf

# ── Source code ────────────────────────────────────────────────────
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.mjs       text eol=lf
*.cjs       text eol=lf
*.json      text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.scss      text eol=lf
*.md        text eol=lf
*.svg       text eol=lf

# ── Config / data ──────────────────────────────────────────────────
*.yml       text eol=lf
*.yaml      text eol=lf
*.toml      text eol=lf
*.xml       text eol=lf
.gitignore  text eol=lf
.gitattributes text eol=lf
.editorconfig  text eol=lf
.prettierrc    text eol=lf
.eslintrc*     text eol=lf
.env*       text eol=lf

# ── Shell / scripts ────────────────────────────────────────────────
*.sh        text eol=lf
*.bash      text eol=lf

# ── Windows-only — keep CRLF ───────────────────────────────────────
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# ── Binary (never normalize) ───────────────────────────────────────
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.webp      binary
*.avif      binary
*.pdf       binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.otf       binary
*.eot       binary
*.mp3       binary
*.mp4       binary
*.zip       binary
*.gz        binary
*.tar       binary
*.7z        binary

# ── Linguist hints (suppress generated files from GitHub diffs) ────
src/routeTree.gen.ts linguist-generated=true
package-lock.json    linguist-generated=true
shared/package-lock.json linguist-generated=true
